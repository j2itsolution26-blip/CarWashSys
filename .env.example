# ---------------------------------------------------------------------------
# CG Car Wash POS — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Neon, Supabase, or any Postgres provider).
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate`.
# On Neon this is the "direct" URL; on Supabase it is port 5432 instead of 6543.
# If your provider has no separate direct URL, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js secret — generate with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Set to the deployed origin in production, e.g. https://cg-carwash.vercel.app
# Vercel sets this automatically; only needed for local dev / custom hosts.
AUTH_URL="http://localhost:3000"

# Trust the host header. Required on Vercel preview deployments and local dev.
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Mail (owner verification codes)
#
# Required for owner self-registration. Without it, registration is refused —
# the system never claims to have sent an email that did not go out.
#
# For Gmail: enable 2-Step Verification on the account, then create an
# App Password (Google Account → Security → App passwords) and use that as
# MAIL_PASSWORD. A normal Gmail password will NOT work over SMTP.
# ---------------------------------------------------------------------------
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USERNAME="your-shop-account@gmail.com"
MAIL_PASSWORD="your-16-character-app-password"
MAIL_FROM_ADDRESS="your-shop-account@gmail.com"
MAIL_FROM_NAME="CG Car Wash"

# Development only: set to "console" to print the verification email to the
# server log INSTEAD OF SENDING IT. Ignored when NODE_ENV=production.
#
# Leave this commented out unless you are deliberately working without SMTP. If
# it is set, no email is ever sent and the verification screen says so — a code
# will never arrive in an inbox, however correct the SMTP settings above are.
#
# Verify the settings above with:  npm run mail:check -- you@gmail.com
# MAIL_TRANSPORT="console"

# ---------------------------------------------------------------------------
# Bootstrap owner account
#
# LEAVE SEED_OWNER_PASSWORD EMPTY in normal installs. The owner then creates
# their own account from the login page and verifies a Gmail address, so no
# shared default credential ever exists.
#
# Set it only for an offline install with no mail server: the seed will create
# the owner directly, pre-verified, and self-registration closes permanently.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL="owner@cgcarwash.local"
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="CG Owner"

# ---------------------------------------------------------------------------
# Business configuration
# ---------------------------------------------------------------------------
# IANA timezone used to compute the "business date" that resets the daily
# customer counter (Customer 1, Customer 2, ...).
BUSINESS_TIMEZONE="Asia/Manila"
NEXT_PUBLIC_BUSINESS_NAME="CG CAR WASH"
